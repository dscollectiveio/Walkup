# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template must be committed. Without this negation the default
# `.env*` glob silently swallows it.
!.env.local.example

# vercel
.vercel

# supabase local dev
supabase/.temp
supabase/.branches

# playwright
/test-results
/playwright-report

# typescript
*.tsbuildinfo
next-env.d.ts

# e2e signed-in session (contains auth cookies)
/tests/e2e/.auth/

# one-off production release helpers (not part of the app)
/scripts/release/
