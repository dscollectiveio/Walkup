# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# The same variables must be set in the Vercel project settings.

# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Slice 2 (AI document intake). Server only.
ANTHROPIC_API_KEY=
# Optional. 1 = treat AI as not configured (every AI feature shows its by-hand path).
WALKUP_AI_DISABLED=
# Optional. off = don't send the server-side refusal fallback (only if the API rejects it).
WALKUP_AI_FALLBACKS=

# Bank feed (read-only, DECISIONS #24). Server only — used by src/lib/plaid.ts.
# Get these from https://dashboard.plaid.com. Sandbox mode works with no real
# bank; Production requires Plaid's own review process.
PLAID_CLIENT_ID=
PLAID_SECRET=
# Required — no default. src/lib/plaid.ts throws rather than silently falling
# back to sandbox if this is unset. One of: sandbox, production.
PLAID_ENV=sandbox
# Needed only for OAuth institutions (most large US banks in production).
# Must be pre-registered with Plaid exactly, https, no query string. Leave
# unset in local dev and on Preview deploys — see DECISIONS #27.
PLAID_REDIRECT_URI=
# Where Plaid posts item-level webhooks (login required, pending disconnect,
# permission revoked). Production only: set to
# https://www.walkuphoa.com/api/plaid/webhook and leave UNSET on Preview and
# local dev. The route verifies Plaid's signature and needs the same
# NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY as the cron job.
# Existing banks keep their old (empty) webhook until reconnected or until a
# board admin runs itemWebhookUpdate for them.
PLAID_WEBHOOK_URL=

# "Find a contractor" (Google Places API (New) Text Search + Place Details,
# and the Geocoding API for the building's address). Server only — read in
# src/lib/google/places.ts and never sent to the browser. Leave unset and the
# Find a contractor tab simply doesn't appear. Restrict the key in Google
# Cloud to those three APIs.
GOOGLE_PLACES_KEY=

# Seals Plaid access tokens (AES-256-GCM) before they are stored, so the
# database holds ciphertext. 32 random bytes, base64. Server only. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use a DIFFERENT key per environment, and never change one that has sealed
# tokens in its database without re-connecting those banks. Unset = tokens are
# stored unsealed (a warning is logged).
# There is no key-rotation procedure yet: keep this value backed up (a password
# manager), because losing it means every connected bank must be reconnected.
BANK_TOKEN_KEY=

# Email sent on behalf of an association after a board admin approves it
# (DECISIONS #36). Server only. Unset = the app works with drafts and mailto only.
RESEND_API_KEY=
# Svix signing secret of the Resend webhook endpoint ("whsec_..."). Needed to record bounces
# and complaints. Endpoint: https://www.walkuphoa.com/api/email/webhook
RESEND_WEBHOOK_SECRET=
# Optional. Default notifications@walkuphoa.com. Must be a verified Resend sender.
EMAIL_FROM_ADDRESS=
# Optional kill switch. 1 = behave as if RESEND_API_KEY were unset (nothing sends, drafts still work).
EMAIL_SENDING_DISABLED=

# The two daily jobs in vercel.json (/api/cron/sync-bank-feeds at 18:00 UTC and
# /api/cron/email-reminders at 15:00 UTC, about 10 a.m. Central). Production only.
# Vercel sends CRON_SECRET as "Authorization: Bearer ..." and each route compares it in
# constant time; with it unset both routes answer 500 "not configured". Any long random string.
CRON_SECRET=
# The service-role key. Used ONLY by the three allowed entry points (DECISIONS #28, #36, #37):
# the bank sync cron, the reminder cron and the Resend webhook (through a six-function
# allowlist), plus the Plaid webhook's one function, plus the Stripe webhook (through a
# five-function billing allowlist). Never set on Preview or local dev.
SUPABASE_SERVICE_ROLE_KEY=

# Walkup's own subscription billing (docs/billing-setup-checklist.md). Server only.
# Both switches are OFF unless set to 1: off means everyone is treated as entitled.
# BILLING_ENABLED=1 shows real status and the Choose a plan / Manage billing buttons.
BILLING_ENABLED=
# BILLING_ENFORCE=1 (only with BILLING_ENABLED) makes a lapsed building read-only.
BILLING_ENFORCE=
# Stripe secret or restricted key (sk_test_/rk_test_ first; a live key is refused
# outside VERCEL_ENV=production).
STRIPE_SECRET_KEY=
# Signing secret ("whsec_...") of the endpoint https://www.walkuphoa.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Stripe price ids ("price_..."), one per tier and interval.
STRIPE_PRICE_STARTER_MONTH=
STRIPE_PRICE_STARTER_YEAR=
STRIPE_PRICE_BUILDING_MONTH=
STRIPE_PRICE_BUILDING_YEAR=
STRIPE_PRICE_ASSOCIATION_MONTH=
STRIPE_PRICE_ASSOCIATION_YEAR=
