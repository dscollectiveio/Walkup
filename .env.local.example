# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# The same variables must be set in the Vercel project settings.

# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never import these into a client component, never prefix with
# NEXT_PUBLIC_. The service role key bypasses row-level security entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Slice 2 (AI document intake). Server only.
ANTHROPIC_API_KEY=

# Bank feed (read-only, DECISIONS #24). Server only — used by src/lib/plaid.ts.
# Get these from https://dashboard.plaid.com. Sandbox mode works with no real
# bank; Production requires Plaid's own review process.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
